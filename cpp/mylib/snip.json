	"base": {
		"prefix": "base",
		"body": [
			"// A進法の string -> 10進法の ll",
			"auto base_to_dec = [](const string& S, ll A) -> ll {",
			"    ll res = 0;",
			"    for (char c : S) {",
			"        ll digit;",
			"        if (c >= '0' && c <= '9') {",
			"            digit = c - '0';",
			"        } else {",
			"            digit = c - 'A' + 10; // 11進法以上 (A~Z) に対応",
			"        }",
			"        res = res * A + digit;",
			"    }",
			"    return res;",
			"};",
			"",
			"// 10進法の ll -> A進法の string",
			"auto dec_to_base = [](ll N, ll A) -> string {",
			"    if (N == 0) return \"0\";",
			"    ",
			"    string res = \"\";",
			"    while (N > 0) {",
			"        int rem = N % A;",
			"        if (rem < 10) {",
			"            res += (char)('0' + rem);",
			"        } else {",
			"            res += (char)('A' + rem - 10); // 11進法以上 (A~Z) に対応",
			"        }",
			"        N /= A;",
			"    }",
			"    // 下の桁から順番に文字列に足されているので、最後に反転させる",
			"    reverse(res.begin(), res.end());",
			"    ",
			"    return res;",
			"};"
		],
		"description": "進数変換"
	},
