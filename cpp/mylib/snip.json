	"rotate_cw": {
		"prefix": "rotate_cw",
		"body": [
			"// 時計回りに90度回転",
			"template <typename T>",
			"Vec<Vec<T>> rotate_cw(const Vec<Vec<T>>& g) {",
			"    int H = g.size();",
			"    if (H == 0) return {};",
			"    int W = g[0].size();",
			"    Vec<Vec<T>> res(W, Vec<T>(H));",
			"    rep(i, 0, H) rep(j, 0, W) {",
			"        res[j][H - 1 - i] = g[i][j];",
			"    }",
			"    return res;",
			"}"
		],
		"description": "時計回りに90度回転"
	},
