	"dijkstra": {
		"prefix": "dijkstra",
		"body": [
			"Vec<ll> dist(N, INF); dist[0]=0; // 始点は適宜変更要",
			"pq_min<pll> q;",
			"q.push({0, 0}); //{その頂点への現時点の最小コスト, 頂点番号}",
			"",
			"while(!q.empty()){",
			"    auto [c, to] = q.top(); q.pop();",
			"    if(dist[to]!=c) continue; //確定している",
			"    for(auto [nv, nc] : G[to]){",
			"        if(dist[nv]<=c+nc) continue; //更新せず",
			"        dist[nv]=c+nc;",
			"        q.push({c+nc, nv});",
			"    }",
			"}"
		],
		"description": "ダイクストラ法"
	},
