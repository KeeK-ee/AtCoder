{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build AtCoder C++ File",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-O2",                         
                "-std=gnu++20",                 
                "-Wall",
                "-Wextra",                      
                "-fsanitize=undefined,address",
                "-I",
                "${workspaceFolder}/ac-library-master",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}